/out/
results/
legacy/outputs*

# Pre-paths.yaml process dumps (keep ignored; new logs live under out/logs/)
artifacts/

# Non-submodule scratch and install-script clones under third_party/.
# Do not blanket-ignore the directory: SimplerEnv-OpenVLA and RoboTwin are
# submodule gitlinks and must remain visible to git.
/third_party/_local/
/third_party/_scratch/
/third_party/robocasa/
/third_party/robosuite/
/third_party/vlsa-aegis/
/third_party/dyniSafety_libero/

# Logs and experiment trackers
*.log
MUJOCO_LOG.TXT
logs/
wandb/
mlruns/
runs/
tensorboard/
events.out.tfevents*

# Generated benchmark outputs
dynamic_RoboTwin/outputs*/
dynamic_SimplerEnv/outputs*/
dynisafety_libero/outputs*/
**/outputs_false_force/
**/videos/
**/*.mp4
**/*.avi
**/*.mov
**/*.webm
**/*.gif

# Anonymous GitHub Pages deploy key + clone (website/publish.sh).
/website/.deploy/

# Paper eval media (rollouts, SR/SSR figures). Public clone is the harness, not our scores.
/website/assets/videos/
/website/assets/figures/

