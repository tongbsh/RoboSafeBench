old_cache/

# Large local install artifacts: simulator source trees, upstream model repos,
# checkpoints, datasets, restricted assets, git mirrors. Obtained via
# scripts/install/install_*.sh and scripts/install/download_assets.py — never committed.
# See external/README.md.
external/
old_logs_cache/

# Local third-party mirrors and scratch caches.
# Publish these separately, use submodules, or document download steps instead.
vlaModelHome/
past_files_cache/
simulator_env/
**/past_cache/

# Dataset dumps and large archives
/data/
/datasets/
download_datasets/
/assets/
dynamic_RoboTwin/RoboTwin/assets/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Runtime artifacts
tmp/
temp/
*.tmp
*.pid
*.seed
# Anchored: a bare `core` also matches the src/dynisafety/core/ package.
/core

# Local bare git mirrors (developer machines only)
/mirrors/

# M9: vendored RoboTwin dual-track fallback (untracked; prefer third_party/RoboTwin)
dynamic_RoboTwin/RoboTwin/

